# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard (Project Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser (used by lib/supabase/client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser. Used only by lib/supabase/admin.ts for privileged operations
# (creating admin accounts, etc.). Get it from Project Settings -> API ->
# service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
