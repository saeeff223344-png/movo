# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard (Project Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser (used by lib/supabase/client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser. Used only by lib/supabase/admin.ts for privileged operations
# (creating admin accounts, etc.). Get it from Project Settings -> API ->
# service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser. Used by lib/ai/openai-client.ts (the /create video planner,
# lib/ai/video-planner.ts) and, when set, also picked up automatically by
# lib/audio/tts-provider-factory.ts as MOVO's fallback/alternative AI
# voiceover provider (lib/audio/providers/openai-tts-provider.ts) — used
# only when ELEVENLABS_API_KEY below isn't set, or if ElevenLabs fails.
# Get it from platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional — overrides the planner's default model (gpt-5.4-mini) without
# a code change. Leave unset to use the default.
OPENAI_MODEL=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser. MOVO's preferred production AI voiceover provider
# (lib/audio/providers/elevenlabs-tts-provider.ts) — lib/audio/tts-provider-factory.ts
# picks ElevenLabs over OpenAI TTS automatically whenever this is set. Get
# it from elevenlabs.io -> Profile -> API Keys.
ELEVENLABS_API_KEY=

# Server-only — not a secret, but still only read server-side. The real
# ElevenLabs *voice id* (never the display name — they are unrelated
# strings) for MOVO's default Arabic advertising voice, "Haytham". Open the
# voice in ElevenLabs' Voice Library and copy its Voice ID (looks like
# "21m00Tcm4TlvDq8ikWAM"). REQUIRED before ElevenLabs can actually be used
# for Arabic narration — until this is set, ElevenLabs Arabic requests fail
# and MOVO automatically falls back to OpenAI TTS (or the silent dev
# fallback). See lib/audio/providers/elevenlabs-voice-config.ts's
# ELEVENLABS_VOICE_SLOTS for how to configure additional Arabic/English
# voices later.
ELEVENLABS_ARABIC_VOICE_ID=

# Server-only secrets — NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser. Used only by lib/render/remotion-lambda-client.ts to render real
# 1080p MP4 exports (lib/actions/export-actions.ts's startExportAction) via
# a deployed Remotion Lambda function on AWS — until all five REMOTION_*
# variables below are set, exporting returns a clear "not configured" error
# instead of failing silently or trying to render inside this Next.js app's
# own (much too short-lived) server functions. One-time setup:
#   1. An AWS account + an IAM user with the permissions
#      `npx remotion lambda policies` documents.
#   2. `npx remotion lambda functions deploy` — prints the function name.
#   3. `npx remotion lambda sites create` — bundles this project to S3,
#      prints the serve URL.
# REMOTION_AWS_ACCESS_KEY_ID / REMOTION_AWS_SECRET_ACCESS_KEY are deliberately
# named differently from the generic AWS_* names so they never collide with
# another AWS SDK's credentials in the same environment (e.g. Vercel's own).
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=

# Server-only secret — NEVER prefix with NEXT_PUBLIC_, never sent to the
# browser. Used only by
# lib/video-generation/providers/runway-video-provider-real.ts for real
# Runway Gen-4 Turbo image-to-video generation (Dynamic AI Video Director +
# Runway Integration phase, lib/actions/video-direction-actions.ts). Get it
# from your Runway account -> API keys.
RUNWAYML_API_SECRET=

# Optional — caps how many scenes per generated video are ever sent to the
# real, paid Runway call, no matter how many the AI Video Director
# recommends (lib/video-director/video-director-config.ts). Defaults to 2.
MOVO_MAX_AI_VIDEO_SCENES=

# Optional — how many seconds each Runway-generated clip is (2-10).
# Defaults to 5. See lib/video-director/video-director-config.ts.
MOVO_AI_VIDEO_DURATION_SECONDS=
